{
  "columns": {
    "warehouse": 0,
    "positionName": 1,
    "quantity": 2,
    "emptyD": 3,
    "cost": 4,
    "revenue": 5
  },
  "skipPatterns": [
    "всего",
    "итого",
    "со склада",
    "отчет по настойкам",
    "название ресторана",
    "период:"
