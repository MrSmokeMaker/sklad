  "defaultPortionSizeMl": 40,
  "normalization": {
    "stripWords": ["40 гр", "40 мл", "40гр", "40мл", "настойка", "сет", "п", "порция"],
    "cleanRegex": "[^a-zA-Zа-яА-Я0-9\\s]"
