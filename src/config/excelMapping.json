  "restaurantAliases": {
    "подворье - бар": "production-podvorie",
    "подворье бар": "production-podvorie",
    "капитал-инвест": "venue-samovar",
    "самовар": "venue-samovar",
    "мордовское подворье": "venue-podvorie",
    "подворье": "venue-podvorie",
    "ева": "venue-eva",
    "eva": "venue-eva"
